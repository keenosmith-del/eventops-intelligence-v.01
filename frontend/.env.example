# Public backend origin. Empty uses Vite's local proxy to port 5050.
VITE_API_BASE_URL=
# Production example: VITE_API_BASE_URL=https://your-api.onrender.com
# Optional local Vite proxy target (not embedded in the frontend bundle):
# API_PROXY_TARGET=http://127.0.0.1:5051
# Never put database credentials, Gemini keys or Mailtrap tokens in this file.
