# Server-only. Copy to the root .env. Never expose these as VITE_* variables.
POSTGRES_USER=eventops
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_DB=eventops_next
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
# Hosted database: use its PostgreSQL URL and TLS. Existing URL sslmode is preserved.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# POSTGRES_SSLMODE=require

# Leave generation disabled for local defaults and automated regression/smoke tests.
GEMINI_ENABLED=false
# GEMINI_API_KEY=
GEMINI_DAILY_LIMIT=10

# Local-only defaults. Public deployments MUST set DEMO_MODE=true and exact origins.
DEMO_MODE=false
# FRONTEND_ORIGINS=https://your-static-site.example
DEMO_SESSION_LIMIT=100
DEMO_REQUEST_LIMIT=2000
DEMO_WRITE_LIMIT=100
AGENT_DAILY_RUN_LIMIT=30

# Optional server-to-server n8n credential, independent of browser sessions.
# Generate at least 32 random characters. Never use a VITE_* variable.
# N8N_SERVICE_TOKEN=
N8N_DAILY_RUN_LIMIT=10

# Real, public read-only HTTPS sources. Override with synthetic EVT-specific sources if desired.
CALENDAR_FEED_URL=https://www.officeholidays.com/ics/south-africa
WEB_SOURCE_URL=https://date.nager.at/api/v3/PublicHolidays/2026/ZA
# Mailtrap Email Testing sandbox; use a dedicated synthetic-data inbox. No send API is exposed.
# MAILTRAP_API_TOKEN=
# MAILTRAP_ACCOUNT_ID=
# MAILTRAP_INBOX_ID=

EMBEDDING_THREADS=1
# FASTEMBED_CACHE_PATH=/tmp/eventops-models
LANGSMITH_TRACING=false
